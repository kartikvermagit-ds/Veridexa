# ==================================================
# KAVRIX × VERIDEXA BACKEND ENVIRONMENT CONFIG
# ==================================================

PROJECT_NAME="Veridexa"
APP_NAME="Veridexa — AI-Powered Product Intelligence"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database Configuration (Defaults to lightweight asynchronous SQLite, PostgreSQL ready)
DATABASE_URL="sqlite+aiosqlite:///./veridexa.db"
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/veridexa"

# AI / LLM Configuration
# Options: "mock" (offline fallback/deterministic), "openai", "anthropic", "gemini"
LLM_PROVIDER="mock"
OPENAI_API_KEY="your-openai-api-key-here"
LLM_MODEL="gpt-4o-mini"
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=25

# Security & CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]
MAX_UPLOAD_SIZE_MB=15
UPLOAD_DIR="./uploads"

# Logging
LOG_LEVEL="INFO"
